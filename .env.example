APP_NAME="OSCE Simulator"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://100.100.22.72:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# The public guest station always uses recorded case data and an evidence review.
OSCE_DEMO_ENABLED=true
AI_PROVIDER=local

# Optional account and provider features. Keep blank for the guest station.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URL=http://100.100.22.72:8000/authenticate
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_AZURE_API_KEY=
OPENAI_AZURE_ENDPOINT=
OPENAI_AZURE_DEPLOYMENT=
OPENAI_AZURE_TIMEOUT=30
USE_MULTI_PROMPT_ASSESSMENT=false

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"
VITE_APP_NAME="${APP_NAME}"
VITE_DEV_SERVER_URL=http://100.100.22.72:5173
VITE_HMR_HOST=100.100.22.72
VITE_HMR_CLIENT_PORT=5173
VITE_DEV_PORT=5173
