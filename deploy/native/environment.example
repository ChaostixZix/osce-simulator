APP_NAME="OSCE Simulator"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://osce.bintangputra.dev
ASSET_URL=https://osce.bintangputra.dev
APP_LOCALE=en
LARAVEL_STORAGE_PATH=/var/lib/osce/storage
DB_CONNECTION=sqlite
DB_DATABASE=/var/lib/osce/database.sqlite
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=osce_session
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
AI_PROVIDER=local
OSCE_DEMO_ENABLED=true
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
GEMINI_API_KEY=
OPENAI_AZURE_API_KEY=
LOG_CHANNEL=single
LOG_LEVEL=warning
MAIL_MAILER=log
