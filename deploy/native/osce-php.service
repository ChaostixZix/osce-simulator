[Unit]
Description=OSCE dedicated PHP-FPM pool
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/babu-out/osce-simulator-fix-20261024/repo
EnvironmentFile=/etc/osce/environment
Environment=PHP_INI_SCAN_DIR=/etc/php/8.3/cli/conf.d
ExecStart=/opt/osce-runtime/php-fpm8.3 -F -c /etc/php/8.3/cli/php.ini -y /etc/osce/php-fpm.conf
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/osce /home/ubuntu/babu-out/osce-simulator-fix-20261024/repo/bootstrap/cache

[Install]
WantedBy=multi-user.target
